{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zukai",
  "version": "0.1.0",
  "identifier": "io.github.peota.zukai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zukai",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost 'self' blob: data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost 'self' blob: data: ws://localhost:1420",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "name": "Text and Markdown",
        "description": "Text or Markdown document",
        "role": "Editor",
        "ext": ["txt", "md", "markdown", "log"]
      },
      {
        "name": "Data and Config",
        "description": "Data or configuration file",
        "role": "Editor",
        "ext": [
          "json",
          "jsonc",
          "xml",
          "yaml",
          "yml",
          "ini",
          "toml",
          "conf",
          "cfg",
          "env",
          "sql"
        ]
      },
      {
        "name": "Web and Source Code",
        "description": "Source code file",
        "role": "Editor",
        "ext": [
          "js",
          "mjs",
          "cjs",
          "ts",
          "tsx",
          "jsx",
          "css",
          "html",
          "htm",
          "py"
        ]
      },
      {
        "name": "Shell and Batch Scripts",
        "description": "Script file",
        "role": "Editor",
        "ext": ["sh", "bash", "zsh", "bat", "cmd", "ps1"]
      }
    ]
  }
}
